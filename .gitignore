# .gitignore for Backup Manager

# Ignore backup archives and incremental backups

configs/*.conf~
*.tar.gz
*.tar.xz
*.bak

# Ignore temporary files

*.swp
*.swo
*.tmp
*.DS_Store

# Python-specific ignores

__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
venv/
env/
.venv/
ENV/

# Packaging / build outputs
build/
dist/
*.egg-info/
.eggs/

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.tox/
.coverage
htmlcov/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore any system files

Thumbs.db
*.log

# Ignore compiled files or scripts outputs (if any)

*.out
*.o
*.class

# Ignore any user-specific files
dev/
.Zicebox/
TODO.md
diff.txt
*.env
*.local

# Keep the script and README tracked

!backup_manager.sh
!README.md
!configs/example.conf
